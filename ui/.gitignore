# Generated by Cargo
# will have compiled files and executables
/target/
/dist/
/static/
/.dioxus/

# Generated by Tailwind from tailwind.css:
/assets/styles.css

# These are backup files generated by rustfmt
**/*.rs.bk

# `public/*`, not `public/`: excluding the directory itself would make the
# negations below unreachable (git never looks inside an excluded directory).
# Re-include the contracts dir, re-ignore its contents, then re-include only
# the two committed WASMs, so stray build output there stays ignored.
public/*
!public/contracts/
public/contracts/*
!public/contracts/room_contract.wasm
!public/contracts/chat_delegate.wasm
node_modules
